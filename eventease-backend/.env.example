# Copy this file to ".env" and change the values.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# If your password has special characters (@ : / # ?) write them URL-encoded (@ -> %40)
DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/eventease"

PORT=8080
# any long random text; used to sign login tokens
JWT_SECRET="change-this-to-a-long-random-text"
JWT_EXPIRES_IN="7d"

# frontend address allowed by CORS (comma separate for more than one)
CLIENT_URL="http://localhost:5173"
CURRENCY="$"

# First admin account (created by `npm run db:seed`). Change the password before you show the project to anyone.
ADMIN_NAME="Site Admin"
ADMIN_EMAIL="admin@eventease.com"
ADMIN_PASSWORD="Eventease@Admin2026"
# AI suggestion prices are in "$"-like units. For another currency set COST_SCALE (example: COST_SCALE=110 with CURRENCY="BDT ")
# COST_SCALE=1
